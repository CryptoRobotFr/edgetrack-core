# EdgeTrack Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Application Mode
# =============================================================================
MODE=docker

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=edgetrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URL for Docker (backend container connects to db container)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database URL for local development (backend runs on host, connects to localhost)
DATABASE_URL_LOCAL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# pgAdmin
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# =============================================================================
# Backend
# =============================================================================
BACKEND_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# Security
# =============================================================================
SECRET_KEY=change-me-in-production-use-a-long-random-string
ENCRYPTION_KEY=change-me-in-production-use-fernet-key

# Email encryption key for PII protection (separate from API key encryption)
# WARNING: If you lose this key, user emails cannot be recovered
# Generate a secure key with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_ENCRYPTION_KEY=change-me-in-production-32-bytes!

# Email hash pepper for HMAC (prevents rainbow table attacks on email_hash)
# WARNING: If you change this, existing users cannot login (email lookup will fail)
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_HASH_PEPPER=change-me-in-production-pepper

# Registration control (default: false = invitation-only after first user)
REGISTRATION_ENABLED=false

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Frontend
# =============================================================================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
